# ============================================================
# RAG 项目环境变量模板
# 用法：复制为 RAG/.env 后按需填写；变量说明中标注了各自的读取方。
# 统一配置入口：src/core_line/config.py（百炼 Key/模型/base_url 集中读取 + 启动预检 preflight()）
# ============================================================


# ------------------------------------------------------------
# 向量库（读取方：src/core_line/vector_store/chromadb_store.py，均可缺省）
# ------------------------------------------------------------
# 向量库本地存储目录（缺省 data/chroma_data）
CHROMA_PERSIST_DIR=data/chroma_data

# Chroma 集合名（缺省 rag_chunks）
CHROMA_COLLECTION_NAME=rag_chunks


# ------------------------------------------------------------
# 百炼（DashScope）配置
# 读取方：src/core_line/config.py 统一读取，供 embedding / rerank 共用
# ------------------------------------------------------------
# —— API Key：三选一即可，按以下顺序优先读取（任一命中即生效）——
#   1) BAILIAN_RERANK_API_KEY   （可选，专用于重排的独立 Key）
BAILIAN_RERANK_API_KEY=

#   2) BAILIAN_EMBEDDING_API_KEY（可选，embedding 与 rerank 共用；当前部署使用此变量）
BAILIAN_EMBEDDING_API_KEY=sk-xxxx

#   3) DASHSCOPE_API_KEY        （可选，兜底；前两者都未配置时生效）
DASHSCOPE_API_KEY=

# 百炼工作空间 ID（注意：当前代码未读取，仅存档预留，可留空）
BAILIAN_WORKSPACEID=ws-xxxx

# 嵌入模型（读取方：config.py -> src/core_line/embedding/bai_lian_embeder.py；
# 有默认值 text-embedding-v4，删掉该行即用默认）
BAILIAN_EMBEDDING_MODEL=text-embedding-v4

# 百炼 API 基址（读取方：config.py -> bai_lian_embeder.py / rerank/reranker.py）
# - 可写兼容模式地址（.../compatible-mode/v1），config.py 自动转换为原生 .../api/v1 基址；
# - 也可直接写原生地址（.../api/v1）；
# - 留空/删除则走 dashscope SDK 公网默认端点（无专属网关时用这种）。
BAILIAN_BASE_URL=https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 重排模型（读取方：config.py -> src/core_line/rerank/reranker.py；
# 有默认值 qwen3-rerank；注意 gte-rerank 已下线勿用）
BAILIAN_RERANK_MODEL=gte-rerank-v2


# ------------------------------------------------------------
# DeepSeek 生成配置
# 读取方：src/core_line/generate/generator.py（DS_API_KEY 为必需项）
# ------------------------------------------------------------
# DeepSeek API Key（必需；启动预检会校验并报出该变量名）
DS_API_KEY=sk-xxxx

# 生成模型（缺省 deepseek-flash）
DS_MODEL=deepseek-flash

# DeepSeek 接口地址（缺省 https://api.deepseek.com）
DS_BASE_URL=https://api.deepseek.com

# 生成/同步调用温度（缺省 0.3；Self-consistency 采样也用此值）
DS_TEMPERATURE=0.3


# ------------------------------------------------------------
# 上下文组装配置（可选）
# 读取方：src/core_line/generate/context_assembler.py
# ------------------------------------------------------------
# 上下文 token 预算（缺省 4096）
CONTEXT_MAX_TOKENS=4096

# 至少保留的 chunk 数（缺省 1）
CONTEXT_MIN_CHUNKS=1

# 单条 chunk 字符上限（缺省 2000）
CONTEXT_MAX_CHUNK_CHARS=2000


# ------------------------------------------------------------
# 生成配置（可选）
# 读取方：src/core_line/generate/generator.py
# ------------------------------------------------------------
# Self-consistency 采样次数上限（缺省 3；并发执行 + 波次提前终止，
# 简单问题自动降为 1 次，复杂问题才用满）
GENERATOR_SELF_CONSISTENCY_N=3

# 采样温度（注意：当前代码未读取此变量，SC 采样温度实际取 DS_TEMPERATURE；仅存档预留）
GENERATOR_TEMPERATURE=0.7

# 单次生成最大 token 数（缺省 2048）
GENERATOR_MAX_TOKENS=2048

# Reflexion 最大迭代轮数（缺省 2）
GENERATOR_MAX_REFLEXION_ROUNDS=2

# 置信度阈值，低于此值触发 Reflexion（缺省 0.5）
GENERATOR_CONFIDENCE_THRESHOLD=0.5


# ------------------------------------------------------------
# 性能 / 缓存配置（可选）
# 读取方：core_line/config.py 统一读取，供 cache.py / generator.py 使用
# ------------------------------------------------------------
# 语义缓存总开关（缺省 true）：嵌入向量 / rerank 打分 / 生成结果按哈希缓存，
# (query 归一化, 索引版本) 不变时生成结果零成本命中；文档 chunk 不变则向量不变
RAG_CACHE_ENABLED=true

# 缓存库文件路径（sqlite；缺省 data/cache/rag_cache.db）
RAG_CACHE_PATH=data/cache/rag_cache.db

# 缓存有效期（天，<=0 表示永不过期；缺省 30）
RAG_CACHE_TTL_DAYS=30

# 生成快速模式（缺省 false）：true 时 SC 固定 1 次采样、跳过 NLI/Reflexion/润色，
# 延迟最低档（简单问答/调试用）
GENERATOR_FAST_MODE=false

# Self-consistency 采样用轻量模型（模型分层：采样/投票用轻量模型、
# 最终润色用 DS_MODEL 强模型；缺省留空 = 与主模型相同，不启用分层）
GENERATOR_SC_MODEL=
